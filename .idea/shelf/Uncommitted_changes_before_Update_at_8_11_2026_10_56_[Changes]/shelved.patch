-# For support, visit: https://github.com/expo-sitory
-# ==================================================================
-
-redis:
-  host: localhost
-  port: 6379
-  password: ""
-
-database:
-  type: mysql
-  enabled: false
-  host: localhost
-  port: 3306
-  database: coordssync
-  username: root
-  password: ""
-  
-
-  pool:
