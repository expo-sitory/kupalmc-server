        else if arg-1 is "clear":
            set {_current-path} to ""
            set {_current-keystone} to ""
            set {_current-slot-1} to ""
            set {_current-slot-2} to ""
            set {_current-slot-3} to ""

            loop {rune-paths::*}:
                if player has permission "runes.path.%loop-value%":
                    set {_current-path} to loop-value
                    stop loop

            if {_current-path} is "precision":
                loop {precision-keystone::*}:
                    if player has permission "runes.keystone.%loop-value%":
                        set {_current-keystone} to loop-value
                        stop loop
                wait 10 ticks
                loop {precision-slot-1::*}:
                    if player has permission "runes.slot-1.%loop-value%":
                        set {_current-slot-1} to loop-value
                        stop loop
                wait 10 ticks
                loop {precision-slot-2::*}:
                    if player has permission "runes.slot-2.%loop-value%":
                        set {_current-slot-2} to loop-value
                        stop loop
                wait 10 ticks
                loop {precision-slot-3::*}:
                    if player has permission "runes.slot-3.%loop-value%":
                        set {_current-slot-3} to loop-value
                        stop loop

