                send "&fPath: %{_current-path}%" to player
                send "&fKeystone: %{_current-keystone}%" to player
                send "&fSlot 1: %{_current-slot-1}%" to player
                send "&fSlot 2: %{_current-slot-2}%" to player
                send "&fSlot 3: %{_current-slot-3}%" to player

